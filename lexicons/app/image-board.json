{
  "lexicon": 1,
  "id": "cloud.pixelboard.imageBoard",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "image",
          "width",
          "height"
        ],
        "properties": {
          "image": {
            "type": "blob",
            "accept": [
              "image/png"
            ]
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 512
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 512
          },
          "createdAt": {
            "type": "string",
            "format": "datetime",
            "description": "Time this drawing was first saved."
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime",
            "description": "Time this drawing was last updated."
          }
        }
      }
    }
  }
}
